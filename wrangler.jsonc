{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "jhd-astro-web",
    "compatibility_date": "2026-03-17",
    "assets": {
      "directory": "./dist",
      "not_found_handling": "404-page"
    },
    "kv_namespaces": [
      {
        "binding": "SESSION",
        "id": "56ef804e458d4ed89c29c5bd44fc6d82"
      }
    ],
    // Without this, @astrojs/cloudflare adds a SESSION binding with no namespace id to
    // previews, and `wrangler preview` rejects it (code 10021).
    "previews": {
      "kv_namespaces": [
        {
          "binding": "SESSION",
          "id": "56ef804e458d4ed89c29c5bd44fc6d82"
        }
      ]
    },
    "observability": {
      "logs": {
        "enabled": true,
        "head_sampling_rate": 1,
        "invocation_logs": true,
        "persist": true
      },
      "traces": {
        "enabled": false,
        "head_sampling_rate": 1,
        "persist": true
      }
    }
  }
