---
// Step bar shared by the showcase directions: one segment per slide in the
// app's accent, a counter, and the site's square control buttons.
interface Props {
  accents: string[];
  prev: string;
  next: string;
  pause: string;
}

const { accents, prev, next, pause } = Astro.props;
const total = String(accents.length).padStart(2, "0");
---

<div class="sc-bar">
  <ol class="sc-segs" aria-hidden="true">
    {accents.map((accent, i) => <li data-seg class:list={{ "is-active": i === 0 }} style={`--seg-accent:${accent}`}></li>)}
  </ol>
  <span class="sc-count" data-count aria-hidden="true">01 / {total}</span>
  <div class="sc-buttons">
    <button type="button" class="sc-btn sc-prev" aria-label={prev}>
      <i class="fa-slab fa-regular fa-angle-left" aria-hidden="true"></i>
    </button>
    <button type="button" class="sc-btn sc-pause" aria-pressed="false" aria-label={pause}>
      <i class="fa-slab fa-regular fa-pause" aria-hidden="true"></i>
    </button>
    <button type="button" class="sc-btn sc-next" aria-label={next}>
      <i class="fa-slab fa-regular fa-angle-right" aria-hidden="true"></i>
    </button>
  </div>
</div>

<style>
  .sc-bar {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px 14px;
    background: #fff;
  }
  .sc-segs {
    display: flex;
    flex: 1;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sc-segs li {
    position: relative;
    flex: 1;
    height: 10px;
    border: var(--border-subtle);
    background: var(--color-surface-2);
    overflow: hidden;
  }
  .sc-segs li::after {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--seg-accent);
    transform: scaleX(0);
    transform-origin: left;
  }
  .sc-segs li.is-done::after {
    transform: none;
  }
  .sc-segs li.is-active::after {
    animation: sc-fill 7s linear forwards;
  }
  :global(.is-paused) .sc-segs li.is-active::after,
  :global(.is-idle) .sc-segs li.is-active::after,
  :global([data-pause-target]:hover) .sc-segs li.is-active::after,
  :global([data-pause-target]:focus-within) .sc-segs li.is-active::after {
    animation: none;
    transform: none;
  }
  @keyframes sc-fill {
    to {
      transform: none;
    }
  }
  .sc-count {
    font-family: var(--font-display);
    font-weight: 800;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .sc-buttons {
    display: flex;
    gap: 8px;
  }
  .sc-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    background: #fff;
    color: #000;
    border: var(--border-base);
    border-radius: 0;
    box-shadow: 4px 4px 0 0 var(--app-accent, var(--color-border));
    cursor: pointer;
    transition: transform 0.15s var(--easing-standard), box-shadow 0.15s var(--easing-standard);
  }
  .sc-btn:hover {
    transform: translate(-2px, -2px);
    box-shadow: 6px 6px 0 0 var(--app-accent, var(--color-border));
  }
  .sc-btn:active {
    transform: translate(-1px, -1px);
  }
  .sc-btn:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 2px;
  }
  .sc-btn[hidden] {
    display: none;
  }
  @media (max-width: 560px) {
    .sc-bar {
      gap: 10px;
      padding: 10px;
    }
    .sc-count {
      display: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .sc-btn {
      transition: none;
    }
    .sc-segs li.is-active::after {
      animation: none;
      transform: none;
    }
  }
</style>
