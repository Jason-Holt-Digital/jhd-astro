---
// Homepage app showcase, direction 2: a strip of framed app cards. The active
// card opens to show its slides; the others fold to narrow spines in their own
// canvas colour. Rotation walks every slide and opens the next app's card.
import AppIconTile from "../../apps/hub/AppIconTile.astro";
import ShowcaseSlide from "./ShowcaseSlide.astro";
import ShowcaseControls from "./ShowcaseControls.astro";
import { getShowcase, showcaseLabels } from "../../../lib/home-showcase";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const labels = showcaseLabels(lang);
const showcase = getShowcase(lang);
const total = showcase.reduce((n, entry) => n + entry.slides.length, 0);
let n = 0;
const numbered = showcase.map((entry) => ({ entry, slides: entry.slides.map((slide) => ({ slide, i: n++ })) }));
---

<section class="app-showcase section-block section-block--band" id="app-showcase" aria-labelledby="app-showcase-title">
  <div class="container section">
    <header class="section-head section-head--left" aria-hidden="true">
      <span class="accent-line" aria-hidden="true"></span>
      <span class="badge-text">{labels.badge}</span>
    </header>
    <h2 id="app-showcase-title" class="section-title section-title--left">{labels.title}</h2>

    <div
      class="appstrip"
      data-showcase
      aria-roledescription="carousel"
      aria-label={t("billboard.aria_label")}
      data-pause-label={t("billboard.pause")}
      data-play-label={labels.play}
      data-slide-label={labels.slide}
      data-of-label={labels.of}
      style={`--app-accent:${showcase[0]!.app.accent}`}
    >
      <div data-pause-target>
        <ul class="appstrip-cards" style={`--n:${showcase.length}`}>
          {numbered.map(({ entry, slides }, a) => (
            <li
              class:list={["appstrip-card", `appstrip-card--${entry.slides[0]!.canvas}`, { "is-active": a === 0 }]}
              data-app-panel
              data-app={entry.app.slug}
              style={`--app-accent:${entry.app.accent}`}
            >
              <button
                type="button"
                class="appstrip-head"
                data-app-btn
                data-app={entry.app.slug}
                aria-expanded={a === 0 ? "true" : "false"}
                aria-controls={`appstrip-body-${entry.app.slug}`}
              >
                <AppIconTile app={entry.app} size={40} />
                <span class="appstrip-name">{entry.app.name}</span>
              </button>
              <div class="appstrip-body" id={`appstrip-body-${entry.app.slug}`}>
                {slides.map(({ slide, i }) => (
                  <div
                    class:list={["appstrip-slide", { "is-active": i === 0 }]}
                    data-slide
                    data-app={entry.app.slug}
                    data-accent={entry.app.accent}
                    role="group"
                    aria-roledescription="slide"
                    aria-label={`${labels.slide} ${i + 1} ${labels.of} ${total}`}
                    inert={i !== 0}
                  >
                    <ShowcaseSlide entry={entry} slide={slide} isPt={isPt} />
                  </div>
                ))}
              </div>
            </li>
          ))}
        </ul>
        <div class="appstrip-bar">
          <ShowcaseControls
            accents={numbered.flatMap(({ entry, slides }) => slides.map(() => entry.app.accent))}
            prev={t("billboard.prev")}
            next={t("billboard.next")}
            pause={t("billboard.pause")}
          />
        </div>
      </div>
      <p class="sr-only" data-status aria-live="off">{labels.slide} 1 {labels.of} {total}</p>
    </div>
  </div>
</section>

<script>
  import "./showcase";
</script>

<style>
  .appstrip {
    --spine: 88px;
    --gap: 18px;
    margin-top: 1.5rem;
  }
  .appstrip-cards {
    display: flex;
    gap: var(--gap);
    height: clamp(32rem, 46vw, 40rem);
    margin: 0;
    padding: 0;
    list-style: none;
    container-type: inline-size;
  }
  .appstrip-card {
    display: flex;
    flex-direction: column;
    flex: 0 0 var(--spine);
    min-width: 0;
    overflow: hidden;
    border: var(--border-thick);
    box-shadow: 8px 8px 0 0 var(--app-accent);
    transition: flex-grow 0.55s var(--easing-standard), transform 0.15s var(--easing-standard), box-shadow 0.15s var(--easing-standard);
  }
  .appstrip-card.is-active {
    flex-grow: 1;
    box-shadow: 12px 12px 0 0 var(--app-accent);
  }
  .appstrip-card--night-folio { background: #1d1729; color: #f3ecdf; }
  .appstrip-card--tomekeeper { background: #141f2d; color: #f5f3ed; }
  .appstrip-card--coming-soon { background: var(--color-accent); color: var(--color-text); }
  .appstrip-card:not(.is-active):hover {
    transform: translate(-2px, -2px);
    box-shadow: 10px 10px 0 0 var(--app-accent);
  }

  .appstrip-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    flex: 1;
    width: 100%;
    padding: 20px 0;
    background: transparent;
    color: inherit;
    border: 0;
    font: inherit;
    cursor: pointer;
  }
  .appstrip-name {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 900;
    letter-spacing: -0.01em;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    white-space: nowrap;
  }
  .appstrip-head:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: -6px;
  }
  .appstrip-card.is-active .appstrip-head {
    flex: none;
    flex-direction: row;
    gap: 12px;
    padding: 10px 16px;
    background: #fff;
    color: var(--color-text);
    border-bottom: var(--border-thick);
    cursor: default;
  }
  .appstrip-card.is-active .appstrip-name {
    writing-mode: horizontal-tb;
    transform: none;
  }

  /* The open card's slides keep their final width while the card grows, so
     the content is revealed instead of reflowing. */
  .appstrip-body {
    display: grid;
    flex: 1;
    width: calc(100cqw - (var(--n) - 1) * (var(--spine) + var(--gap)) - 6px);
    min-height: 0;
    text-align: left;
  }
  .appstrip-card:not(.is-active) .appstrip-body {
    display: none;
  }
  .appstrip-slide {
    grid-area: 1 / 1;
    min-height: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--easing-standard), visibility 0s 0.6s;
  }
  .appstrip-slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--easing-standard), visibility 0s;
  }

  .appstrip-bar {
    margin-top: 26px;
    border: var(--border-thick);
    box-shadow: 6px 6px 0 0 var(--app-accent);
  }

  @media (max-width: 760px) {
    .appstrip-cards {
      flex-direction: column;
      gap: 14px;
      height: auto;
    }
    .appstrip-card,
    .appstrip-card.is-active {
      flex: none;
      box-shadow: 6px 6px 0 0 var(--app-accent);
    }
    .appstrip-head {
      flex-direction: row;
      gap: 12px;
      padding: 10px 14px;
    }
    .appstrip-name {
      writing-mode: horizontal-tb;
      transform: none;
      font-size: 1.125rem;
    }
    .appstrip-body {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .appstrip-card,
    .appstrip-slide,
    .appstrip-slide.is-active {
      transition: none;
    }
  }
</style>
