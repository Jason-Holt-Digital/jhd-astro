---
// Homepage app showcase, direction 1: one framed stage. The app tabs are site
// buttons; the stage cross-fades slide by slide through every app, and its
// offset shadow takes the current app's accent.
import AppIconTile from "../../apps/hub/AppIconTile.astro";
import ShowcaseSlide from "./ShowcaseSlide.astro";
import ShowcaseControls from "./ShowcaseControls.astro";
import { getShowcase, showcaseLabels } from "../../../lib/home-showcase";
import { getLangFromUrl, useTranslations } from "../../../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isPt = lang === "pt";
const labels = showcaseLabels(lang);
const showcase = getShowcase(lang);
const slides = showcase.flatMap((entry) => entry.slides.map((slide) => ({ entry, slide })));
---

<section class="app-showcase section-block section-block--band" id="app-showcase" aria-labelledby="app-showcase-title">
  <div class="container section">
    <header class="section-head section-head--left" aria-hidden="true">
      <span class="accent-line" aria-hidden="true"></span>
      <span class="badge-text">{labels.badge}</span>
    </header>
    <h2 id="app-showcase-title" class="section-title section-title--left">{labels.title}</h2>

    <div
      class="stage"
      data-showcase
      aria-roledescription="carousel"
      aria-label={t("billboard.aria_label")}
      data-pause-label={t("billboard.pause")}
      data-play-label={labels.play}
      data-slide-label={labels.slide}
      data-of-label={labels.of}
      style={`--app-accent:${showcase[0]!.app.accent}`}
    >
      <div class="stage-tabs" role="group" aria-label={labels.apps}>
        {showcase.map((entry, i) => (
          <button
            type="button"
            class="btn btn--tertiary btn--compact stage-tab"
            data-app-btn
            data-app={entry.app.slug}
            aria-pressed={i === 0 ? "true" : "false"}
            style={`--tab-accent:${entry.app.accent}`}
          >
            <AppIconTile app={entry.app} size={28} />
            {entry.app.name}
          </button>
        ))}
      </div>

      <div class="stage-frame" data-pause-target>
        <div class="stage-slides">
          {slides.map(({ entry, slide }, i) => (
            <div
              class:list={["stage-slide", { "is-active": i === 0 }]}
              data-slide
              data-app={entry.app.slug}
              data-accent={entry.app.accent}
              role="group"
              aria-roledescription="slide"
              aria-label={`${labels.slide} ${i + 1} ${labels.of} ${slides.length}`}
              inert={i !== 0}
            >
              <ShowcaseSlide entry={entry} slide={slide} isPt={isPt} />
            </div>
          ))}
        </div>
        <ShowcaseControls
          accents={slides.map(({ entry }) => entry.app.accent)}
          prev={t("billboard.prev")}
          next={t("billboard.next")}
          pause={t("billboard.pause")}
        />
      </div>
      <p class="sr-only" data-status aria-live="off">{labels.slide} 1 {labels.of} {slides.length}</p>
    </div>
  </div>
</section>

<script>
  import "./showcase";
</script>

<style>
  .stage {
    margin-top: 1.5rem;
  }
  .stage-tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 22px;
  }
  .stage-tab {
    font-size: 1rem;
    cursor: pointer;
    box-shadow: 4px 4px 0 0 var(--tab-accent);
  }
  .stage-tab :global(.app-icon-tile) {
    border-width: 1px;
    box-shadow: none;
  }
  .stage-tab[aria-pressed="true"] {
    background: #000;
    color: #fff;
    box-shadow: 6px 6px 0 0 var(--tab-accent);
  }
  .stage-tab:focus-visible {
    outline: 3px solid var(--color-primary);
    outline-offset: 3px;
  }

  .stage-frame {
    border: var(--border-thick);
    background: #fff;
    box-shadow: 12px 12px 0 0 var(--app-accent);
    transition: box-shadow 0.4s var(--easing-standard);
  }
  /* Every slide shares one grid cell, so the stage is as tall as the tallest
     slide and never jumps between apps. */
  .stage-slides {
    display: grid;
    border-bottom: var(--border-thick);
  }
  .stage-slide {
    grid-area: 1 / 1;
    min-height: clamp(30rem, 44vw, 39rem);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.6s var(--easing-standard), visibility 0s 0.6s;
  }
  .stage-slide.is-active {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.6s var(--easing-standard), visibility 0s;
  }

  @media (max-width: 760px) {
    .stage-tabs {
      gap: 12px 10px;
    }
    .stage-tab {
      font-size: 0.9375rem;
    }
    .stage-frame {
      box-shadow: 8px 8px 0 0 var(--app-accent);
    }
    .stage-slide {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .stage-frame,
    .stage-slide,
    .stage-slide.is-active {
      transition: none;
    }
  }
</style>
