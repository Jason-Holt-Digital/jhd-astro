---
import { Font } from "astro:assets";
---

<!-- Self-hosted site fonts (configured in astro.config.mjs). Only the latin
     files are preloaded; latin-ext loads when a page needs it. -->
<Font cssVariable="--font-display" preload={[{ subset: "latin" }]} />
<Font cssVariable="--font-body" preload={[{ subset: "latin" }]} />
