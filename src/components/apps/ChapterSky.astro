---
// Backdrop for one app chapter on the Night Folio canvas: a soft hue glow and
// the faint nebula art. Both fade to transparent at the top and bottom, so
// neighbouring chapters blend with no seam. The art drifts a little slower
// than the page (a CSS scroll-driven animation, no script), and holds still
// when reduced motion is on or the browser lacks scroll timelines.
import { Image } from "astro:assets";
import nebula from "../../assets/mythic-gme/1.7.0/nebula.jpg";

interface Props {
  hue: string;
}

const { hue } = Astro.props;
---

<div class="sky" style={`--sky-hue: ${hue}`} aria-hidden="true">
  <Image class="sky-art" src={nebula} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="lazy" />
</div>

<style>
  .sky {
    position: absolute;
    inset: 0;
    pointer-events: none;
    view-timeline: --sky;
    mask-image: linear-gradient(180deg, transparent 0, #000 20%, #000 80%, transparent 100%);
  }

  .sky::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(70% 45% at 75% 40%, color-mix(in oklab, var(--sky-hue) 55%, transparent), transparent);
  }

  .sky-art {
    position: absolute;
    inset: -8% 0;
    width: 100%;
    height: 116%;
    object-fit: cover;
    opacity: 0.2;
  }

  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .sky-art {
        animation: sky-drift linear both;
        animation-timeline: --sky;
      }
    }
  }

  @keyframes sky-drift {
    from {
      transform: translateY(-6%);
    }
    to {
      transform: translateY(6%);
    }
  }
</style>
