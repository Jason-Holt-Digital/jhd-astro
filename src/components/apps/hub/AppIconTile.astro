---
import { Image } from "astro:assets";
import type { AppEntry } from "../../../lib/apps";

interface Props {
  app: AppEntry;
  size?: number;
}

const { app, size = 72 } = Astro.props;
---

<span
  class:list={["app-icon-tile", { "app-icon-tile--placeholder": !app.icon }]}
  style={`--tile-size:${size}px; --app-accent:${app.accent};`}
  aria-hidden="true"
>
  {app.icon && (
    <Image src={app.icon} alt="" width={size * 2} height={size * 2} loading="lazy" decoding="async" />
  )}
</span>
