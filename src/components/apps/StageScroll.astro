---
// Redesign direction B, "Choose, then scroll the stage": two app cards to pick
// from, then for each app a sticky dark stage whose clip changes as the
// approved feature lines scroll past, and a grid of the remaining lines.
import { Image } from "astro:assets";
import ClipDevice from "./ClipDevice.astro";
import nebula from "../../assets/mythic-gme/1.7.0/nebula.jpg";
import { groupFeatures, clips, type Clip } from "../../lib/mythic-gme-clips";

type App = {
  title: string;
  whoItsFor: string;
  features: string[];
  officialContent: string[];
  iapInfo?: string;
  disclaimer?: string;
  storeLinks: Array<{ name: string; url: string; icon: string; available?: boolean }>;
};

interface Props {
  mobileApp: App;
  desktopApp: App;
  mobileGroups: Array<{ clip: Clip; lines: number[] }>;
  digitalGroups: Array<{ clip: Clip; lines: number[] }>;
  lang: "en" | "pt";
}

const { mobileApp, desktopApp, mobileGroups, digitalGroups, lang } = Astro.props;
const isPt = lang === "pt";
const apps = [
  { id: "mobile", badge: isPt ? "App mobile" : "Mobile App", app: mobileApp, cover: clips.exceptionalYes, ...groupFeatures(mobileApp.features, mobileGroups) },
  { id: "desktop", badge: isPt ? "App desktop" : "Desktop App", app: desktopApp, cover: clips.desktopThrow, ...groupFeatures(desktopApp.features, digitalGroups) },
];
const label = {
  does: isPt ? "O que o app faz" : "What it does",
  official: isPt ? "Conteúdo oficial" : "Official content",
  download: isPt ? "Baixar agora" : "Download now",
  soon: isPt ? "Em breve" : "Coming soon",
};
---

<div class="st">
  <div class="st-choose">
    {
      apps.map(({ id, badge, app, cover }) => (
        <a class="st-card" href={`#${id}`}>
          <span class="st-card-art" aria-hidden="true">
            <Image src={cover.poster} alt="" width={cover.device === "phone" ? 360 : 720} loading="lazy" />
          </span>
          <span class="st-eyebrow">{badge}</span>
          <span class="st-card-title">{app.title}</span>
          <span class="st-card-lead">{app.whoItsFor}</span>
        </a>
      ))
    }
  </div>

  {
    apps.map(({ id, badge, app, groups, rest }) => (
      <section id={id} class="st-app" aria-labelledby={`${id}-title`}>
        <Image class="st-sky" src={nebula} alt="" widths={[960, 1600, 2400]} sizes="100vw" loading="lazy" />
        <div class="st-inner">
          <header class="st-head">
            <p class="st-eyebrow" aria-hidden="true">{badge}</p>
            <h2 id={`${id}-title`} class="st-title">{app.title}</h2>
            <p class="st-lead">{app.whoItsFor}</p>
          </header>

          <div class:list={["st-scroller", { "st-scroller--single": groups.length === 1 }]} data-stage>
            <div class="st-stage" aria-hidden="true">
              {groups.map((g, i) => (
                <div class:list={["st-stage-item", { "is-active": i === 0 }]} data-stage-item={i}>
                  <ClipDevice clip={g.clip} />
                </div>
              ))}
            </div>
            <ol class="st-steps">
              {groups.map((g, i) => (
                <li class="st-step" data-stage-step={i}>
                  <div class="st-step-media">
                    <ClipDevice clip={g.clip} />
                  </div>
                  <h3 class="st-step-title">{g.headline}</h3>
                  {g.lines.length > 0 && (
                    <ul class="st-step-lines">
                      {g.lines.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  )}
                </li>
              ))}
            </ol>
          </div>

          <h3 class="st-eyebrow st-grid-label">{label.does}</h3>
          <ul class="st-grid">
            {rest.map((line) => (
              <li class="st-tile">
                <i class="fa-slab fa-regular fa-check" aria-hidden="true" />
                <span>{line}</span>
              </li>
            ))}
          </ul>

          <div class="st-buy">
            <div>
              <h3 class="st-eyebrow">{label.official}</h3>
              <ul class="st-official">
                {app.officialContent.map((line) => (
                  <li>{line}</li>
                ))}
              </ul>
              {app.iapInfo && <p class="st-note">{app.iapInfo}</p>}
              {app.disclaimer && <p class="st-note">{app.disclaimer}</p>}
            </div>
            <div>
              <h3 class="st-eyebrow">{label.download}</h3>
              <div class="st-stores">
                {app.storeLinks.map((store) =>
                  store.available === false ? (
                    <span class="st-store st-store--off" aria-disabled="true">
                      <i class={store.icon} aria-hidden="true" />
                      {store.name} · {label.soon}
                    </span>
                  ) : (
                    <a class="st-store" href={store.url} target="_blank" rel="noopener noreferrer">
                      <i class={store.icon} aria-hidden="true" />
                      {store.name}
                    </a>
                  ),
                )}
              </div>
            </div>
          </div>
        </div>
      </section>
    ))
  }
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-stage]").forEach((scroller) => {
    const items = [...scroller.querySelectorAll<HTMLElement>("[data-stage-item]")];
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const index = (entry.target as HTMLElement).dataset.stageStep;
          items.forEach((item) => item.classList.toggle("is-active", item.dataset.stageItem === index));
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    );
    scroller.querySelectorAll("[data-stage-step]").forEach((step) => observer.observe(step));
  });
</script>

<style>
  .st {
    --st-ink: #f3ecdf;
    --st-muted: #c9bfd6;
    --st-gold: #d8be84;
    --st-gold-deep: #b39556;
  }

  .st-choose {
    width: min(1120px, 100% - 2.5rem);
    margin: 0 auto clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .st-card {
    display: grid;
    grid-template-rows: auto auto auto 1fr;
    gap: 0.4rem;
    padding: 1.5rem;
    border-radius: 22px;
    text-decoration: none;
    color: var(--st-ink);
    background: linear-gradient(160deg, #3e384e 0%, #241d33 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 6px 18px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    transition: transform 200ms ease;
  }

  .st-card:hover {
    transform: translateY(-3px);
  }

  .st-card:focus-visible {
    outline: 2px solid var(--st-gold-deep);
    outline-offset: 3px;
  }

  .st-card-art {
    height: 220px;
    margin: -1.5rem -1.5rem 1rem;
    overflow: hidden;
    background: #1d1729;
  }

  .st-card-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0.92;
  }

  .st-card-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 700;
    font-size: 1.75rem;
    line-height: 1.1;
  }

  .st-card-lead {
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    color: var(--st-gold);
    font-size: 1.05rem;
    line-height: 1.4;
  }

  .st-eyebrow {
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--st-gold);
    margin: 0 0 0.75rem;
  }

  .st-app {
    position: relative;
    overflow: clip;
    color: var(--st-ink);
    background: linear-gradient(180deg, #241d33 0%, #1d1729 100%);
    padding: clamp(4rem, 8vw, 6.5rem) 0;
  }

  .st-app + .st-app {
    background: linear-gradient(180deg, #1c2333 0%, #161a26 100%);
  }

  .st-sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.16;
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .st-inner {
    position: relative;
    width: min(1120px, 100% - 2.5rem);
    margin: 0 auto;
  }

  .st-head {
    text-align: center;
    max-width: 44rem;
    margin: 0 auto clamp(2.5rem, 6vw, 4rem);
  }

  .st-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    line-height: 1.02;
    color: var(--st-ink);
    margin: 0;
  }

  .st-lead {
    font-family: "Fraunces", Georgia, serif;
    font-style: italic;
    font-size: clamp(1.2rem, 2.2vw, 1.5rem);
    color: var(--st-gold);
    margin: 0.75rem 0 0;
  }

  .st-scroller {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .st-scroller--single {
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    align-items: center;
  }

  .st-stage {
    position: sticky;
    top: 12vh;
    height: 76vh;
    display: grid;
  }

  .st-scroller--single .st-stage {
    position: static;
    height: auto;
  }

  .st-stage-item {
    grid-area: 1 / 1;
    display: grid;
    place-items: center;
    opacity: 0;
    transform: translateY(12px) scale(0.98);
    transition:
      opacity 250ms ease,
      transform 250ms ease;
  }

  .st-stage-item.is-active {
    opacity: 1;
    transform: none;
  }

  .st-stage-item :global(.clip-device--phone) {
    width: auto;
    height: min(70vh, 620px);
  }

  .st-stage-item :global(.clip-device--phone .loop-clip) {
    height: 100%;
    width: auto;
  }

  .st-steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .st-step {
    min-height: 70vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .st-scroller--single .st-step {
    min-height: 0;
  }

  .st-step-media {
    display: none;
  }

  .st-step-title {
    font-family: "Fraunces", Georgia, serif;
    font-weight: 600;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.15;
    margin: 0 0 1rem;
    color: var(--st-ink);
  }

  .st-step-lines {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .st-step-lines li {
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 1.05rem;
    line-height: 1.5;
    color: var(--st-muted);
    padding: 0.6rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .st-grid-label {
    text-align: center;
  }

  .st-grid {
    list-style: none;
    margin: 0 0 clamp(2.5rem, 5vw, 4rem);
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
  }

  .st-tile {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1.1rem 1.2rem;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.07);
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--st-ink);
  }

  .st-tile i {
    color: var(--st-gold);
    margin-top: 0.2rem;
  }

  .st-buy {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: clamp(1.5rem, 4vw, 3rem);
    padding: clamp(1.5rem, 4vw, 2.5rem);
    border-radius: 22px;
    background: rgba(0, 0, 0, 0.25);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.06);
  }

  .st-official {
    list-style: none;
    margin: 0 0 1.25rem;
    padding: 0;
  }

  .st-official li {
    font-family: "Fraunces", Georgia, serif;
    line-height: 1.45;
    padding: 0.55rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .st-note {
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--st-muted);
    margin: 0 0 1rem;
  }

  .st-stores {
    display: grid;
    gap: 0.6rem;
  }

  .st-store {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: "IBM Plex Sans", system-ui, sans-serif;
    font-weight: 600;
    color: #5c4820;
    text-decoration: none;
    padding: 0.75rem 1rem;
    border-radius: 10px;
    background: linear-gradient(180deg, #c9ab6c 0%, #b39556 100%);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.45);
  }

  .st-store:focus-visible {
    outline: 2px solid var(--st-gold);
    outline-offset: 2px;
  }

  .st-store--off {
    background: rgba(255, 255, 255, 0.08);
    color: var(--st-muted);
    box-shadow: none;
  }

  @media (max-width: 860px) {
    .st-choose,
    .st-scroller,
    .st-scroller--single,
    .st-buy {
      grid-template-columns: 1fr;
    }

    .st-grid {
      grid-template-columns: 1fr;
    }

    .st-stage {
      display: none;
    }

    .st-step {
      min-height: 0;
      margin-bottom: 3rem;
    }

    .st-step-media {
      display: grid;
      place-items: center;
      margin-bottom: 1.5rem;
    }

    .st-step-media :global(.clip-device--phone) {
      width: min(72%, 280px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .st-stage-item,
    .st-card {
      transition: none;
    }
  }
</style>
