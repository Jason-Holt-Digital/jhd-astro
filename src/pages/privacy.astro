---
import { Image } from "astro:assets";
import PrivacyArticle from "../components/legal/PrivacyArticle.astro";
import TomeKeeperPrivacyArticle from "../components/legal/TomeKeeperPrivacyArticle.astro";
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/layout/PageHeader.astro';
import mythicIcon from "../assets/apps/mythic-gme-icon.png";
import tomekeeperIcon from "../assets/apps/tomekeeper-icon.png";
---
<BaseLayout
  title="Privacy Policy | Jason Holt Digital"
  description="How the Mythic GME apps and TomeKeeper handle your data: what each app collects, why, and how to turn it off."
  canonicalPath="/privacy/"
  alternatePath="/pt/privacy/"
  mainClass="legal-main"
>
  <PageHeader
    title="Privacy Policy"
    subtitle="Your privacy, protected"
    description="Minimal data collection, local-first storage, and clear controls."
    accent="Privacy"
    layout="left"
    icon="fa-solid fa-shield-check"
    visualElement="grid"
    colorScheme="primary"
  />

  <section class="section" aria-labelledby="privacy-body">
    <div class="container legal-container">
      <header class="section-head" aria-hidden="true">
        <span class="accent-line" aria-hidden="true"></span>
        <span class="badge-text">Policy</span>
      </header>
      <h2 id="privacy-body" class="section-title">What I collect and why</h2>

      <!-- Without JS the tabs are anchor links and CSS :target picks the panel; the script upgrades them to ARIA tabs. -->
      <div class="privacy-tabs" data-privacy-tabs>
        <div class="privacy-tabs__list" data-privacy-tablist>
          <a class="privacy-tab" href="#mythic-gme" id="mythic-gme-tab" style="--tab-accent:#0066ff" data-privacy-tab>
            <Image src={mythicIcon} alt="" width={28} height={28} class="privacy-tab__icon" />
            Mythic GME
          </a>
          <a class="privacy-tab" href="#tomekeeper" id="tomekeeper-tab" style="--tab-accent:#355781" data-privacy-tab>
            <Image src={tomekeeperIcon} alt="" width={28} height={28} class="privacy-tab__icon" />
            TomeKeeper
          </a>
        </div>

        <div class="privacy-panel" id="mythic-gme" data-privacy-panel>
          <p class="legal-updated">Last updated: November 6, 2026</p>
          <p class="legal-summary">
            I built the Mythic GME apps for the community, and I want to be straightforward about how they handle your data. This policy explains
            what I collect, why I collect it, and what controls you have.
          </p>
          <PrivacyArticle />
        </div>

        <div class="privacy-panel" id="tomekeeper" data-privacy-panel>
          <p class="legal-updated">Last updated: November 13, 2026</p>
          <p class="legal-summary">
            TomeKeeper is a PDF reader for tabletop roleplaying games. This policy explains what leaves your device, why, and
            how to turn it off.
          </p>
          <TomeKeeperPrivacyArticle />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-privacy-tabs]');
  const tablist = root?.querySelector<HTMLElement>('[data-privacy-tablist]');
  if (root && tablist) {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-privacy-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-privacy-panel]'));

    tablist.setAttribute('role', 'tablist');
    tablist.setAttribute('aria-label', 'Privacy policy by app');
    tabs.forEach((tab, i) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[i].id);
      panels[i].setAttribute('role', 'tabpanel');
      panels[i].setAttribute('aria-labelledby', tab.id);
      panels[i].tabIndex = 0;
    });

    const select = (index: number, { focus = false, updateUrl = false } = {}) => {
      tabs.forEach((tab, i) => {
        const selected = i === index;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        panels[i].hidden = !selected;
      });
      if (focus) tabs[index].focus();
      if (updateUrl) history.replaceState(null, '', `#${panels[index].id}`);
    };

    // A hash can name a panel or any heading inside one, such as #google-microsoft-amazon.
    const panelIndexForHash = () => {
      const id = location.hash.slice(1);
      const target = id ? document.getElementById(id)?.closest('[data-privacy-panel]') : null;
      return target ? panels.indexOf(target as HTMLElement) : -1;
    };

    const app = new URLSearchParams(location.search).get('app');
    const fromHash = panelIndexForHash();
    const fromQuery = panels.findIndex((panel) => panel.id === app);
    select(fromHash >= 0 ? fromHash : Math.max(fromQuery, 0));
    root.dataset.enhanced = '';

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        select(i, { updateUrl: true });
      });
    });

    tablist.addEventListener('keydown', (event) => {
      const current = tabs.indexOf(document.activeElement as HTMLAnchorElement);
      if (current < 0) return;
      const last = tabs.length - 1;
      let next: number | null = null;
      if (event.key === 'ArrowRight') next = current === last ? 0 : current + 1;
      else if (event.key === 'ArrowLeft') next = current === 0 ? last : current - 1;
      else if (event.key === 'Home') next = 0;
      else if (event.key === 'End') next = last;
      else if (event.key === ' ') next = current;
      if (next === null) return;
      event.preventDefault();
      select(next, { focus: true, updateUrl: true });
    });

    // The browser scrolls before this runs, while the target is still hidden, so scroll again once it is shown.
    window.addEventListener('hashchange', () => {
      const index = panelIndexForHash();
      if (index < 0) return;
      select(index);
      document.getElementById(location.hash.slice(1))?.scrollIntoView();
    });
  }
</script>
