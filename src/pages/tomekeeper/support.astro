---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/layout/PageHeader.astro';
---
<BaseLayout
  title="Tome Keeper Support | Jason Holt Digital"
  description="Get help with Tome Keeper, the PDF reader for tabletop roleplaying games, including guides, email support, and answers to common questions."
  canonicalPath="/tomekeeper/support/"
  noAlternate
  mainClass="support-main"
>
  <PageHeader
    title="Tome Keeper Support"
    subtitle="Help with your books at the table"
    description="Guides, email support, and answers to common questions about Tome Keeper."
    accent="Support"
    layout="left"
    icon="fa-solid fa-life-ring"
    visualElement="particles"
    colorScheme="accent"
  />

  <section class="section" aria-labelledby="tk-support-title">
    <div class="container support-container">
      <header class="section-head" aria-hidden="true">
        <span class="accent-line" aria-hidden="true"></span>
        <span class="badge-text">Support</span>
      </header>
      <div class="support-intro">
        <h2 id="tk-support-title" class="section-title">Get help with Tome Keeper</h2>
        <p class="support-intro__summary">
          Browse the guides, read the answers below, or email me with bugs and questions.
        </p>
      </div>

      <section aria-labelledby="tk-help-title">
        <h2 id="tk-help-title">How to Get Help</h2>
        <div class="twoup">
          <div class="panel">
            <h3>Guides</h3>
            <p>Walkthroughs for importing books, setting up Sets and bookmarks, building Tables, and turning on sync.</p>
            <p>
              <a class="btn btn--shadow-primary" href="/tomekeeper/guides/">
                <i class="fa-slab fa-regular fa-book-open" aria-hidden="true"></i>
                Read the Guides
              </a>
            </p>
          </div>
          <div class="panel">
            <h3>Email Support</h3>
            <p>Send bug reports, beta feedback, and questions by email. Include your device, the app version, and what happened.</p>
            <p>
              <a class="btn btn--shadow-primary" href="mailto:ryan@jasonholtdigital.com?subject=Tome%20Keeper%20support">
                <i class="fa-slab fa-regular fa-envelope" aria-hidden="true"></i>
                Email Support
              </a>
            </p>
            <p class="support-subnote"><a href="mailto:ryan@jasonholtdigital.com">ryan@jasonholtdigital.com</a></p>
          </div>
        </div>
      </section>

      <section id="faqs" aria-labelledby="tk-faqs-title">
        <h2 id="tk-faqs-title">Common Questions</h2>

        <div class="faq-section">
          <h3 class="faq-section-heading">
            <button class="faq-section-header" aria-expanded="true" aria-controls="tk-general-section">
              About Tome Keeper
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </h3>
          <div id="tk-general-section" class="faq-section-content open">

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-what-is">
                <strong>What is Tome Keeper?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-what-is" class="faq-answer" inert>
                <p>Tome Keeper is a PDF reader for tabletop roleplaying games. Read your rulebooks and adventures without clunky toolbars getting in the way, organize your library with tags and Sets, and jump straight into prep or play by clipping sections or whole pages from multiple books onto a Table for yourself or your group.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-platforms">
                <strong>Which devices does it run on?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-platforms" class="faq-answer" inert>
                <p>iPhone, iPad, Mac, Windows, and Android. During the beta, you can join through TestFlight on Apple devices and through Google Play on Android. On Windows, you can get it from the Microsoft Store.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-account">
                <strong>Do I need an account?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-account" class="faq-answer" inert>
                <p>No. Tome Keeper has no accounts. Open the app and import a PDF.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="faq-section">
          <h3 class="faq-section-heading">
            <button class="faq-section-header" aria-expanded="false" aria-controls="tk-books-section">
              Books &amp; Import
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </h3>
          <div id="tk-books-section" class="faq-section-content" inert>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-import">
                <strong>How do I add a book?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-import" class="faq-answer" inert>
                <p>Tap Import on the home screen, stay on Local PDF, and tap Choose PDF to pick one or more PDFs from your device. You can also send a PDF straight into Tome Keeper from another app using the system Share Sheet, Open In, or Open With. Tome Keeper copies each PDF into its own storage, so the book stays available even if you move or delete the original file.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-dtrpg">
                <strong>Can I import my DriveThruRPG purchases?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-dtrpg" class="faq-answer" inert>
                <p>Yes. In Import, choose DriveThruRPG and connect with your DriveThruRPG API key. Then select the purchased PDFs you want and import them. The app talks to DriveThruRPG directly, and your key is stored only in your device's secure storage. Disconnecting removes it.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-where-stored">
                <strong>Where are my books and notes stored?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-where-stored" class="faq-answer" inert>
                <p>Your library stays on your device by default. On Windows, books and notes stay in local storage on that device. On iPhone, iPad, and Mac, you can turn on optional iCloud Sync in Settings to sync through your own private iCloud account. On Android, you can turn on optional Google Drive Sync in Settings to sync through a hidden app data folder in your own Google Drive, where book PDFs upload only on Wi-Fi. Sync is off by default on each device, and Jason Holt Digital never receives or stores your synced library data. Book PDFs upload only when Sync book files is on. Deleting the app does not delete copies already in iCloud, Google Drive, or on your other devices, and you should still keep your original PDFs.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="faq-section">
          <h3 class="faq-section-heading">
            <button class="faq-section-header" aria-expanded="false" aria-controls="tk-privacy-section">
              Privacy &amp; Diagnostics
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </h3>
          <div id="tk-privacy-section" class="faq-section-content" inert>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-diagnostics">
                <strong>What does Share diagnostics send?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-diagnostics" class="faq-answer" inert>
                <p>App errors and performance timings, with your app version, device model and operating system. Never your PDFs, notes, book titles, screenshots or recordings. It is on by default; switch it off in Settings, under Diagnostics. The <a href="/privacy/#tomekeeper">privacy policy</a> lists everything the app sends.</p>
              </div>
            </div>
          </div>
        </div>

        <div class="faq-section">
          <h3 class="faq-section-heading">
            <button class="faq-section-header" aria-expanded="false" aria-controls="tk-bugs-section">
              Reporting Problems
              <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
            </button>
          </h3>
          <div id="tk-bugs-section" class="faq-section-content" inert>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-report-bug">
                <strong>How do I report a bug?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-report-bug" class="faq-answer" inert>
                <p>Email <a href="mailto:ryan@jasonholtdigital.com">ryan@jasonholtdigital.com</a>. Include your device, the app version, and the steps that led to the problem. On TestFlight, you can also take a screenshot and send it as beta feedback.</p>
              </div>
            </div>

            <div class="faq-item">
              <button class="faq-question" aria-expanded="false" aria-controls="tk-pdf-problem">
                <strong>A PDF won't open or looks wrong. What should I send?</strong>
                <i class="fa-solid fa-chevron-down" aria-hidden="true"></i>
              </button>
              <div id="tk-pdf-problem" class="faq-answer" inert>
                <p>Tell me the book's title and publisher, where you got it, and which pages are affected. Please don't attach the PDF unless I ask; most publishers don't allow sharing their files.</p>
              </div>
            </div>
          </div>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<script>
  // Collapsed panels are hidden only by max-height, so `inert` keeps their
  // buttons and links out of the tab order and the accessibility tree.
  function initFAQAccordion() {
    document.querySelectorAll<HTMLButtonElement>('.faq-section-header').forEach((header) => {
      header.addEventListener('click', () => {
        const isExpanded = header.getAttribute('aria-expanded') === 'true';
        const content = document.getElementById(header.getAttribute('aria-controls') ?? '');
        header.setAttribute('aria-expanded', (!isExpanded).toString());
        if (!content) return;
        content.classList.toggle('open', !isExpanded);
        content.inert = isExpanded;
        if (isExpanded) {
          content.querySelectorAll<HTMLButtonElement>('.faq-question').forEach((q) => q.setAttribute('aria-expanded', 'false'));
          content.querySelectorAll<HTMLElement>('.faq-answer').forEach((a) => {
            a.classList.remove('open');
            a.inert = true;
          });
        }
      });
    });

    document.querySelectorAll<HTMLButtonElement>('.faq-question').forEach((question) => {
      question.addEventListener('click', () => {
        const isExpanded = question.getAttribute('aria-expanded') === 'true';
        const answer = document.getElementById(question.getAttribute('aria-controls') ?? '');
        question.setAttribute('aria-expanded', (!isExpanded).toString());
        if (!answer) return;
        answer.classList.toggle('open', !isExpanded);
        answer.inert = isExpanded;
      });
    });
  }

  document.addEventListener('DOMContentLoaded', initFAQAccordion);
</script>
