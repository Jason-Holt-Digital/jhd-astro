---
// TomeKeeper ships in English only, so this page has no PT alternate.
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppIconTile from "../../components/apps/hub/AppIconTile.astro";
import { getApps } from "../../lib/apps";

const tk = getApps("en").find((app) => app.slug === "tomekeeper")!;

const featureGroups = [
  {
    id: "library",
    title: "Your library",
    icon: "fa-slab fa-regular fa-book-bookmark",
    shot: "Library screenshot",
    items: [
      "Import PDFs from your device. TomeKeeper keeps its own copy, so the book stays put even if you move the original.",
      "Connect your DriveThruRPG account with your own API key and import the PDFs you bought.",
      "Organize books with library tags, and group them into sets, for example everything for one campaign.",
    ],
  },
  {
    id: "reading",
    title: "Reading",
    icon: "fa-slab fa-regular fa-book-open",
    shot: "Spread layout screenshot",
    items: [
      "Single page, two-page spread, or Stitch for continuous reading.",
      "Jump with the page scrubber, Go to page, or the book's contents.",
      "Every tool lives in one Tools panel, so the page stays clear.",
    ],
  },
  {
    id: "find",
    title: "Find it at the table",
    icon: "fa-slab fa-regular fa-bookmark",
    shot: "Bookmark tabs screenshot",
    items: [
      "Bookmarks with category colors appear as tabs on the page edge. One tap takes you there.",
      "Page tags pin named markers to a spot on the page, such as a monster stat block or a trap.",
      "Search one book or every book in a set, across text, contents, bookmarks and page tags.",
    ],
  },
  {
    id: "tables",
    title: "Tables",
    icon: "fa-slab fa-regular fa-chess-board",
    shot: "Table board screenshot",
    items: [
      "A Table is a board for a session or a campaign. Clip a map, a table or a stat block from any page and place it on the board.",
      "Add notes, counters, checklists, frames and shapes.",
      "Import character sheet PDFs onto a Table, fill in the fields, and export a filled copy.",
      "Link a Table to a set and open it from the book you are reading.",
    ],
  },
];

const smallGroups = [
  {
    title: "Dice",
    icon: "fa-slab fa-regular fa-dice-d20",
    body: "Roll dice from the Viewer without leaving the page.",
  },
  {
    title: "Make it yours",
    icon: "fa-slab fa-regular fa-palette",
    body: "Light, dark or system theme, seven interface colors, and fourteen app icons.",
  },
  {
    title: "Private by design",
    icon: "fa-slab fa-regular fa-shield",
    body: "No account, no ads, no tracking. Your PDFs, bookmarks, tags and Tables stay on your device. The app sends error reports and performance data so I can fix problems. You can turn this off in Settings, under Diagnostics.",
  },
];
---
<BaseLayout
  title="TomeKeeper: PDF reader for tabletop RPGs | Jason Holt Digital"
  description="TomeKeeper is a PDF reader for tabletop RPGs on iPhone, iPad, Mac and Android. Bookmark rules, tag pages, search a set of books, and pin clips to a Table."
  canonicalPath="/tomekeeper/"
  noAlternate
>
  <div class="tk-page" style={`--app-accent:${tk.accent}`}>
    <nav class="tk-crumbs container" aria-label="Breadcrumb">
      <a href="/apps/">Apps</a>
      <i class="fa-slab fa-regular fa-angle-right" aria-hidden="true"></i>
      <span aria-current="page">TomeKeeper</span>
    </nav>

    <section class="tk-hero" aria-labelledby="tk-title">
      <div class="container tk-hero__grid">
        <div class="tk-hero__copy">
          <div class="tk-hero__id">
            <AppIconTile app={tk} size={88} />
            <div>
              <p class="tk-kicker">{tk.tagline}</p>
              <h1 id="tk-title" class="tk-hero__title">TomeKeeper</h1>
            </div>
          </div>
          <p class="tk-hero__lead">
            A PDF reader built for tabletop roleplaying games. Bring your rulebooks, adventures and supplements into one library, mark what matters, and find it again fast in the middle of a session.
          </p>
          <ul class="platform-chips" aria-label="Platforms">
            {tk.platforms.map((platform) => <li>{platform}</li>)}
          </ul>
          <div class="tk-download" id="download">
            <span class="app-status app-status--coming-soon">Coming soon</span>
            <p>TomeKeeper is coming soon. Store links will appear here when it launches.</p>
          </div>
        </div>
        <div class="tk-hero__media" aria-hidden="true">
          <div class="shot-placeholder shot-placeholder--tablet tk-hero__tablet">
            <i class="fa-slab fa-regular fa-image fa-2x"></i>
            iPad screenshot
          </div>
          <div class="shot-placeholder shot-placeholder--phone tk-hero__phone">
            <i class="fa-slab fa-regular fa-image fa-2x"></i>
            iPhone screenshot
          </div>
        </div>
      </div>
    </section>

    <nav class="tk-jump" aria-label="On this page">
      <div class="container tk-jump__row">
        {featureGroups.map((group) => (
          <a href={`#${group.id}`}><i class={group.icon} aria-hidden="true"></i>{group.title}</a>
        ))}
        <a href="#more"><i class="fa-slab fa-regular fa-plus" aria-hidden="true"></i>More</a>
      </div>
    </nav>

    {featureGroups.map((group, index) => (
      <section class:list={["tk-feature", { "tk-feature--alt": index % 2 === 1 }]} id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="container tk-feature__grid">
          <div class="tk-feature__copy">
            <p class="tk-feature__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <h2 id={`${group.id}-title`} class="tk-feature__title">{group.title}</h2>
            <ul class="tk-feature__list">
              {group.items.map((item) => (
                <li><i class="fa-slab fa-regular fa-check" aria-hidden="true"></i><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <div class="shot-placeholder shot-placeholder--tablet tk-feature__shot" aria-hidden="true">
            <i class="fa-slab fa-regular fa-image fa-2x"></i>
            {group.shot}
          </div>
        </div>
      </section>
    ))}

    <section class="section tk-more" id="more" aria-labelledby="tk-more-title">
      <div class="container">
        <h2 id="tk-more-title" class="sr-only">More features</h2>
        <div class="tk-more__grid">
          {smallGroups.map((group) => (
            <article class="tk-more__card">
              <h3><i class={group.icon} aria-hidden="true"></i>{group.title}</h3>
              <p>{group.body}</p>
            </article>
          ))}
        </div>
        <p class="tk-note">
          <i class="fa-slab fa-regular fa-circle-info" aria-hidden="true"></i>
          TomeKeeper does not include any books. Bring your own PDFs.
        </p>
      </div>
    </section>

    <section class="section tk-help" aria-labelledby="tk-help-title">
      <div class="container tk-help__row">
        <div>
          <h2 id="tk-help-title" class="tk-help__title">Questions or problems?</h2>
          <p>Read the answers to common questions, or email me with bugs and beta feedback.</p>
        </div>
        <div class="tk-help__links">
          <a class="btn btn--shadow-primary" href="/tomekeeper/support/">
            <i class="fa-slab fa-regular fa-life-ring" aria-hidden="true"></i>TomeKeeper support
          </a>
          <a class="btn btn--tertiary" href="/tomekeeper/privacy/">
            <i class="fa-slab fa-regular fa-shield" aria-hidden="true"></i>Privacy policy
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tk-page {
    --tk-brass: #b88743;
    --tk-paper: #fbfaf6;
  }
  .tk-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .tk-crumbs a {
    color: var(--color-text-muted);
  }
  .tk-hero {
    padding: 2rem 0 4rem;
    border-bottom: var(--border-thick);
  }
  .tk-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    align-items: center;
  }
  .tk-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
  .tk-hero__id {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .tk-hero__id .app-icon-tile {
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-kicker {
    margin: 0 0 4px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--app-accent);
  }
  .tk-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tk-hero__lead {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
    color: #2d3748;
    max-width: 36rem;
  }
  .tk-download {
    display: grid;
    gap: 8px;
    justify-items: start;
    width: 100%;
    max-width: 30rem;
    padding: 16px 18px;
    background: var(--tk-paper);
    border: var(--border-base);
    box-shadow: 5px 5px 0 0 var(--app-accent);
  }
  .tk-download p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .tk-hero__media {
    position: relative;
    padding: 0 0 40px 0;
  }
  .tk-hero__tablet {
    width: 88%;
    box-shadow: 10px 10px 0 0 var(--app-accent);
  }
  .tk-hero__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-jump {
    background: #fff;
    border-bottom: var(--border-base);
  }
  .tk-jump__row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-block: 10px;
    scrollbar-width: none;
  }
  .tk-jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    white-space: nowrap;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    border: var(--border-subtle);
  }
  .tk-jump a:hover {
    background: var(--app-accent);
    color: #fff;
  }
  .tk-feature {
    padding: 4.5rem 0;
    border-bottom: var(--border-base);
    scroll-margin-top: 64px;
  }
  .tk-feature--alt {
    background: var(--tk-paper);
  }
  .tk-feature__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .tk-feature--alt .tk-feature__copy {
    order: 2;
  }
  .tk-feature__num {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 900;
    color: var(--tk-brass);
  }
  .tk-feature__title {
    margin: 4px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .tk-feature__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tk-feature__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .tk-feature__list i {
    margin-top: 4px;
    color: var(--app-accent);
  }
  .tk-feature__shot {
    box-shadow: 8px 8px 0 0 var(--app-accent);
  }
  .tk-more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .tk-more__card {
    padding: 22px;
    background: #fff;
    border: var(--border-base);
    box-shadow: 5px 5px 0 0 var(--app-accent);
  }
  .tk-more__card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .tk-more__card h3 i {
    color: var(--app-accent);
  }
  .tk-more__card p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .tk-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 2rem 0 0;
    font-weight: 700;
  }
  .tk-note i {
    color: var(--tk-brass);
  }
  .tk-help {
    background: #141f2d;
    color: #f5f3ed;
  }
  .tk-help__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .tk-help__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 900;
  }
  .tk-help p {
    margin: 0;
    color: rgba(245, 243, 237, 0.82);
  }
  .tk-help__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .tk-help .btn--shadow-primary {
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-help .btn--tertiary {
    border-color: #f5f3ed;
  }
  @media (max-width: 900px) {
    .tk-hero__grid,
    .tk-feature__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .tk-feature--alt .tk-feature__copy {
      order: 0;
    }
    .tk-more__grid {
      grid-template-columns: 1fr;
    }
    .tk-feature {
      padding: 3rem 0;
    }
  }
  @media (max-width: 560px) {
    .tk-hero__id {
      gap: 14px;
    }
    .tk-hero__id {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
