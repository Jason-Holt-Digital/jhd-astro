---
// Tome Keeper ships in English only, so this page has no PT alternate.
import { Image, Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AppIconTile from "../../components/apps/hub/AppIconTile.astro";
import { getApps } from "../../lib/apps";
import homeIpad from "../../assets/apps/tomekeeper/home-ipad.jpg";
import homeIphone from "../../assets/apps/tomekeeper/home-iphone.jpg";
import setsIpad from "../../assets/apps/tomekeeper/sets-ipad.jpg";
import toolsIpad from "../../assets/apps/tomekeeper/tools-ipad.jpg";
import bookmarksIpad from "../../assets/apps/tomekeeper/bookmarks-ipad.jpg";
import tableIpad from "../../assets/apps/tomekeeper/table-ipad.jpg";
import ryanPhoto from "../../assets/people/ryan-holt.jpg";
import RyanHoltNote from "../../components/makers/RyanHoltNote.astro";

const tk = getApps("en").find((app) => app.slug === "tomekeeper")!;

const featureGroups = [
  {
    id: "reading",
    title: "Reading",
    icon: "fa-slab fa-regular fa-book-open",
    shot: toolsIpad,
    alt: "A two-page spread of the Mythic GME 2e Fate Chart in Tome Keeper on iPad, with the Tools panel open showing Open Books, View, Search, Contents, Bookmarks, Bookmark, Clip, and Tags.",
    lead: "Read your books for the full-page art, spreads, and stories first. The Tools button stays tucked in the corner until you need it, so nothing sits between you and the page.",
    items: [
      "Read in single-page view or a two-page open-book spread with a faint fold crease, and turn on Show first page as cover when a cover belongs on its own.",
      "Use Lock layout to keep your chosen view steady as you rotate your device, and move fast with the page scrubber, Go to page, or the book's contents.",
      "Open the Tools panel in the corner whenever you want to switch from reading straight into bookmarking, searching, or clipping for game prep.",
    ],
  },
  {
    id: "library",
    title: "Your library",
    icon: "fa-slab fa-regular fa-book-bookmark",
    shot: setsIpad,
    alt: "My Sets in Tome Keeper on iPad showing five sets, including Mythic Solo, Fabula Ultima, Legend in the Mist, Broken Empires, and Daggerheart.",
    items: [
      "Import one or more PDFs from your device or send them straight in from the system Share Sheet. Tome Keeper keeps its own copy on your device, so your book stays put even if you move or delete the original.",
      "Connect your DriveThruRPG account with your own API key and import the PDFs you already own.",
      "Sort your shelf with Library Tags and group up to 8 books into a Set for a campaign or system.",
      "Switch between open books from the top Book Strip or the open-books stack without losing your page.",
    ],
  },
  {
    id: "find",
    title: "Find it at the table",
    icon: "fa-slab fa-regular fa-bookmark",
    shot: bookmarksIpad,
    alt: "The Fabula Ultima introduction in Tome Keeper on iPad, with colored bookmark tabs on the page edge for Introduction, Scenes, Checks, Clocks, Conflict, and Fabula Points.",
    items: [
      "Mark key rules across 8 bookmark categories plus your own custom colors. Bookmarks show up as tabs on the page edge so one tap takes you right there.",
      "Pin Page Tags to specific spots on maps and pages, such as a monster stat block, a room key, or a trap.",
      "Search one book or every book in a Set at once, with matching Bookmarks and Page Tags ranked ahead of body text.",
    ],
  },
  {
    id: "tables",
    title: "Tables",
    icon: "fa-slab fa-regular fa-chess-board",
    shot: tableIpad,
    alt: "A Table in Tome Keeper on iPad with a Broken Empires map, an adventure cover, the Mythic Fate Chart, a Chaos Factor counter, and a note for the next scene.",
    lead: "Jump straight from reading into prep and play. Whether you run a group campaign or play solo, pull sections or whole pages from multiple books onto one Table and arrange them in a way that makes sense for you and your players.",
    items: [
      "Clip a rules table, stat block, map, or whole page from any book onto your Table, then select any clip to jump straight back to its source page.",
      "Keep your prep intact when a publisher releases a revised PDF. Replace the book file and update your clips from the new edition.",
      "Build out your board with sticky notes, frames, counters, checklists, shapes, images, and fillable PDF character sheets from Components > Import > PDF. Your original PDFs stay untouched.",
      "Link a Table to a Set so you can open your prep board from whichever book you are reading.",
    ],
  },
];

const smallGroups = [
  {
    title: "Dice",
    icon: "fa-slab fa-regular fa-dice-d20",
    body: "Roll up to 12 3D dice from d4 through d100 in the Viewer or on a Table, and check your roll history anytime.",
  },
  {
    title: "Make it yours",
    icon: "fa-slab fa-regular fa-palette",
    body: "Choose Light, Dark, or System theme, 7 bookcloth colors, 3 spine bindings in Linen, Smooth, or Quarter cloth, and 7 woven cloth app icons on Apple and Android.",
  },
  {
    title: "Private by design",
    icon: "fa-slab fa-regular fa-shield",
    body: "No account, no ads, and no tracking. Your Tome Keeper library stays on your device, with optional iCloud Sync on Apple devices and Google Drive Sync on Android.",
    link: { href: "/tomekeeper/privacy/", text: "Privacy policy" },
  },
];
---
<BaseLayout
  title="Tome Keeper: PDF reader for tabletop RPGs | Jason Holt Digital"
  description="Tome Keeper is a PDF reader for tabletop RPGs on iPhone, iPad, Mac, Windows, and Android. Enjoy full-page art and spreads without clutter, then clip pages from multiple books onto a Table for prep and play."
  canonicalPath="/tomekeeper/"
  noAlternate
>
  <div class="tk-page" style={`--app-accent:${tk.accent}`}>
    <nav class="tk-crumbs container" aria-label="Breadcrumb">
      <a href="/apps/">Apps</a>
      <i class="fa-slab fa-regular fa-angle-right" aria-hidden="true"></i>
      <span aria-current="page">Tome Keeper</span>
    </nav>

    <section class="tk-hero" aria-labelledby="tk-title">
      <div class="container tk-hero__grid">
        <div class="tk-hero__copy">
          <div class="tk-hero__id">
            <AppIconTile app={tk} size={88} />
            <div>
              <p class="tk-kicker">{tk.tagline}</p>
              <h1 id="tk-title" class="tk-hero__title">Tome Keeper</h1>
            </div>
          </div>
          <p class="tk-hero__lead">
            Enjoy the art, spreads, and stories in your tabletop RPG books without clunky PDF toolbars getting in the way. When it is time to prep or run a game, clip pages from multiple books onto one Table and arrange them the way you and your players actually use them.
          </p>
          <ul class="platform-chips" aria-label="Platforms">
            {tk.platforms.map((platform) => <li>{platform}</li>)}
          </ul>
          <div class="tk-download" id="download">
            <span class="app-status app-status--coming-soon">Coming soon</span>
            <p>Tome Keeper is coming soon. Store links will appear here when it launches.</p>
          </div>
        </div>
        <figure class="tk-hero__media">
          <Image
            class="tk-shot tk-hero__tablet"
            src={homeIpad}
            alt="Tome Keeper's home screen on iPad showing Mythic Game Master Emulator 2e under Continue Reading, with My Books, My Sets, and Tables below."
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 88vw, 560px"
            loading="eager"
            fetchpriority="high"
          />
          <Image
            class="tk-shot tk-hero__phone"
            src={homeIphone}
            alt="Tome Keeper's home screen on iPhone."
            widths={[240, 480]}
            sizes="(max-width: 900px) 26vw, 170px"
            loading="eager"
          />
          <figcaption class="tk-hero__caption">PDFs sold separately.</figcaption>
        </figure>
      </div>
    </section>

    <nav class="tk-jump" aria-label="On this page">
      <div class="container tk-jump__row">
        {featureGroups.map((group) => (
          <a href={`#${group.id}`}><i class={group.icon} aria-hidden="true"></i>{group.title}</a>
        ))}
        <a href="#more"><i class="fa-slab fa-regular fa-plus" aria-hidden="true"></i>More</a>
      </div>
    </nav>

    {featureGroups.map((group, index) => (
      <section class:list={["tk-feature", { "tk-feature--alt": index % 2 === 1 }]} id={group.id} aria-labelledby={`${group.id}-title`}>
        <div class="container tk-feature__grid">
          <div class="tk-feature__copy">
            <p class="tk-feature__num" aria-hidden="true">{String(index + 1).padStart(2, "0")}</p>
            <h2 id={`${group.id}-title`} class="tk-feature__title">{group.title}</h2>
            {group.lead && <p class="tk-feature__lead">{group.lead}</p>}
            <ul class="tk-feature__list">
              {group.items.map((item) => (
                <li><i class="fa-slab fa-regular fa-check" aria-hidden="true"></i><span>{item}</span></li>
              ))}
            </ul>
          </div>
          <Image
            class="tk-shot tk-feature__shot"
            src={group.shot}
            alt={group.alt}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 900px) 92vw, 560px"
          />
        </div>
      </section>
    ))}

    <section class="section tk-more" id="more" aria-labelledby="tk-more-title">
      <div class="container">
        <h2 id="tk-more-title" class="sr-only">More features</h2>
        <div class="tk-more__grid">
          {smallGroups.map((group) => (
            <article class="tk-more__card">
              <h3><i class={group.icon} aria-hidden="true"></i>{group.title}</h3>
              <p>{group.body}{group.link && <> <a href={group.link.href}>{group.link.text}</a></>}</p>
            </article>
          ))}
        </div>
        <p class="tk-note">
          <i class="fa-slab fa-regular fa-circle-info" aria-hidden="true"></i>
          Tome Keeper does not include any books. Bring your own PDFs.
        </p>
      </div>
    </section>

    <section class="section tk-maker" id="makers-note" aria-labelledby="tk-maker-title">
      <div class="container">
        <article class="tk-maker__card">
          <div class="tk-maker__who">
            <Picture
              class="tk-maker__photo"
              src={ryanPhoto}
              formats={["avif", "webp"]}
              width={96}
              height={96}
              widths={[96, 192]}
              sizes="96px"
              alt="Ryan Holt"
              loading="lazy"
              decoding="async"
            />
            <div>
              <h2 id="tk-maker-title" class="tk-maker__title">Maker's note</h2>
              <p class="tk-maker__name">Ryan Holt</p>
            </div>
          </div>
          <div class="tk-maker__body">
            <RyanHoltNote />
          </div>
        </article>
      </div>
    </section>

    <section class="section tk-help" aria-labelledby="tk-help-title">
      <div class="container tk-help__row">
        <div>
          <h2 id="tk-help-title" class="tk-help__title">Questions or problems?</h2>
          <p>Browse the guides, read answers to common questions, or email me with bugs and beta feedback.</p>
        </div>
        <div class="tk-help__links">
          <a class="btn btn--shadow-primary" href="/tomekeeper/guides/">
            <i class="fa-slab fa-regular fa-book-open" aria-hidden="true"></i>Tome Keeper guides
          </a>
          <a class="btn btn--shadow-accent" href="/tomekeeper/support/">
            <i class="fa-slab fa-regular fa-life-ring" aria-hidden="true"></i>Tome Keeper support
          </a>
          <a class="btn btn--tertiary" href="/privacy/#tomekeeper">
            <i class="fa-slab fa-regular fa-shield" aria-hidden="true"></i>Privacy policy
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .tk-page {
    --tk-brass: #b88743;
    --tk-paper: #fbfaf6;
  }
  .tk-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 1.25rem;
    font-size: 0.875rem;
    font-weight: 700;
  }
  .tk-crumbs a {
    color: var(--color-text-muted);
  }
  .tk-hero {
    padding: 2rem 0 4rem;
    border-bottom: var(--border-thick);
  }
  .tk-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    align-items: center;
  }
  .tk-hero__copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    min-width: 0;
  }
  .tk-hero__id {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .tk-hero__id .app-icon-tile {
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-kicker {
    margin: 0 0 4px;
    font-size: 0.8125rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--app-accent);
  }
  .tk-hero__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.6vw, 3.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
    line-height: 1;
  }
  .tk-hero__lead {
    margin: 0;
    font-size: 1.25rem;
    line-height: 1.55;
    color: #2d3748;
    max-width: 36rem;
  }
  .tk-download {
    display: grid;
    gap: 8px;
    justify-items: start;
    width: 100%;
    max-width: 30rem;
    padding: 16px 18px;
    background: var(--tk-paper);
    border: var(--border-base);
    box-shadow: 5px 5px 0 0 var(--app-accent);
  }
  .tk-download p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .tk-shot {
    display: block;
    height: auto;
    border: var(--border-thick);
    border-radius: 18px;
  }
  .tk-hero__media {
    position: relative;
    margin: 0;
    padding: 0 0 40px 0;
  }
  .tk-hero__tablet {
    width: 88%;
    box-shadow: 10px 10px 0 0 var(--app-accent);
  }
  .tk-hero__phone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 26%;
    border-radius: 22px;
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-hero__caption {
    position: absolute;
    left: 0;
    bottom: 0;
    font-size: 0.8125rem;
    color: var(--color-text-muted);
  }
  .tk-jump {
    background: #fff;
    border-bottom: var(--border-base);
  }
  .tk-jump__row {
    display: flex;
    gap: 6px;
    overflow-x: auto;
    padding-block: 10px;
    scrollbar-width: none;
  }
  .tk-jump a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    white-space: nowrap;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
    border: var(--border-subtle);
  }
  .tk-jump a:hover {
    background: var(--app-accent);
    color: #fff;
  }
  .tk-feature {
    padding: 4.5rem 0;
    border-bottom: var(--border-base);
    scroll-margin-top: 64px;
  }
  .tk-feature--alt {
    background: var(--tk-paper);
  }
  .tk-feature__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 56px;
    align-items: center;
  }
  .tk-feature--alt .tk-feature__copy {
    order: 2;
  }
  .tk-feature__num {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 900;
    color: var(--tk-brass);
  }
  .tk-feature__title {
    margin: 4px 0 20px;
    font-family: var(--font-display);
    font-size: clamp(1.875rem, 4vw, 2.75rem);
    font-weight: 900;
    letter-spacing: -0.02em;
  }
  .tk-feature__lead {
    margin: 0 0 20px;
    font-size: 1.1875rem;
    line-height: 1.55;
    color: #2d3748;
  }
  .tk-feature__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tk-feature__list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 12px;
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .tk-feature__list i {
    margin-top: 4px;
    color: var(--app-accent);
  }
  .tk-feature__shot {
    width: 100%;
    box-shadow: 8px 8px 0 0 var(--app-accent);
  }
  .tk-more__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .tk-more__card {
    padding: 22px;
    background: #fff;
    border: var(--border-base);
    box-shadow: 5px 5px 0 0 var(--app-accent);
  }
  .tk-more__card h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 10px;
    font-size: 1.25rem;
    font-weight: 800;
  }
  .tk-more__card h3 i {
    color: var(--app-accent);
  }
  .tk-more__card p {
    margin: 0;
    color: var(--color-text-muted);
    line-height: 1.6;
  }
  .tk-more__card a {
    color: var(--app-accent);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .tk-more__card a:hover {
    text-decoration-thickness: 2px;
  }
  .tk-note {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 2rem 0 0;
    font-weight: 700;
  }
  .tk-note i {
    color: var(--tk-brass);
  }
  .tk-maker__card {
    max-width: 820px;
    margin-inline: auto;
    padding: 2rem;
    background: #fff;
    border: var(--border-thick);
    box-shadow: 8px 8px 0 0 var(--app-accent);
  }
  .tk-maker__who {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 1.5rem;
  }
  .tk-maker__photo {
    flex: none;
    width: 96px;
    height: 96px;
    border-radius: 50%;
    border: var(--border-base);
    object-fit: cover;
  }
  .tk-maker__title {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 900;
  }
  .tk-maker__name {
    margin: 0.25rem 0 0;
    font-weight: 700;
    color: var(--color-text-muted);
  }
  .tk-maker__body :global(p) {
    margin: 0 0 1rem;
    color: #333;
    line-height: 1.7;
  }
  .tk-maker__body :global(p:last-child) {
    margin-bottom: 0;
  }
  .tk-help {
    background: #141f2d;
    color: #f5f3ed;
  }
  .tk-help__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .tk-help__title {
    margin: 0 0 6px;
    font-family: var(--font-display);
    font-size: 1.875rem;
    font-weight: 900;
  }
  .tk-help p {
    margin: 0;
    color: rgba(245, 243, 237, 0.82);
  }
  .tk-help__links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }
  .tk-help .btn--shadow-primary {
    box-shadow: 6px 6px 0 0 var(--tk-brass);
  }
  .tk-help .btn--tertiary {
    border-color: #f5f3ed;
  }
  @media (max-width: 900px) {
    .tk-hero__grid,
    .tk-feature__grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }
    .tk-feature--alt .tk-feature__copy {
      order: 0;
    }
    .tk-more__grid {
      grid-template-columns: 1fr;
    }
    .tk-feature {
      padding: 3rem 0;
    }
  }
  @media (max-width: 768px) {
    .tk-maker__card {
      padding: 1.25rem;
    }
    .tk-maker__photo {
      width: 72px;
      height: 72px;
    }
    .tk-maker__title {
      font-size: 1.5rem;
    }
  }
  @media (max-width: 560px) {
    .tk-hero__id {
      gap: 14px;
    }
    .tk-hero__id {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
